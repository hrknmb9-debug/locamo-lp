# Copy this file to .env (gitignored). Fill in Stripe test keys first for payment flows.

# ── Stripe（ローカルはテストモード推奨: sk_test_ / pk_test_ / whsec_）
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# フロントで Stripe Elements 等を使う場合（現状 Pricing は Payment Links でも可）
VITE_STRIPE_PUBLISHABLE_KEY=

# ローカル Webhook の例（Stripe CLI が必要: https://stripe.com/docs/stripe-cli）:
#   pnpm stripe:listen
# または: stripe listen --forward-to http://127.0.0.1:3000/api/stripe/webhook
# 表示される Signing secret を STRIPE_WEBHOOK_SECRET に貼り付ける

# ── アプリ共通（詳細は STRIPE_IMPLEMENTATION.md / STRIPE_PRODUCTION_GUIDE.md）
NODE_ENV=development
PORT=3000
DATABASE_URL=
JWT_SECRET=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

# Hearing 送信（任意）
DISCORD_HEARING_WEBHOOK_URL=
